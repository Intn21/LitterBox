# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.python-version

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Experiment artifacts — configs, notes, and results.json ARE tracked;
# checkpoints, logs, and raw data are not.
*.pt
*.pth
*.safetensors
*.bin
checkpoints/
wandb/
runs/
outputs/
# Top-level corpora only — the leading slash keeps src/litterbox/data/ tracked.
# (No trailing comments in this file: git reads them as part of the pattern,
# which is how this rule silently matched nothing.)
/data/
!experiments/**/results.json
!experiments/**/*.yaml
!experiments/**/*.md

# Local planning notes — the README is the public version of this
context.md

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Notebooks
.ipynb_checkpoints/
